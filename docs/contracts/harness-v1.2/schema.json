{
  "$defs": {
    "Answer": {
      "description": "One resolution to a paused approval or question, in the MCP elicitation\nshape (``action``/``content``): a caller's answer to something the run asked.",
      "properties": {
        "action": {
          "enum": [
            "accept",
            "decline",
            "cancel"
          ],
          "title": "Action",
          "type": "string"
        },
        "approvalToken": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approvaltoken"
        },
        "content": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "questionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Questionid"
        }
      },
      "required": [
        "action"
      ],
      "title": "Answer",
      "type": "object"
    },
    "ApprovalEntry": {
      "description": "One approval a run asked for and how it ended; ``token`` is the approval's own token.\n\n``tool``/``callId`` name the paused call. See ``ApprovalLedger`` for how ``outcome`` is set.",
      "properties": {
        "callId": {
          "title": "Callid",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "accepted",
            "declined",
            "timed_out",
            "refused_content",
            "unanswered"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "token",
        "tool",
        "callId",
        "outcome"
      ],
      "title": "ApprovalEntry",
      "type": "object"
    },
    "BlockedInfo": {
      "description": "Which policy rule stopped the run, when ``status`` is ``\"blocked\"``.",
      "properties": {
        "call_id": {
          "default": "",
          "title": "Call Id",
          "type": "string"
        },
        "denial_kind": {
          "default": "",
          "title": "Denial Kind",
          "type": "string"
        },
        "policy_id": {
          "default": "",
          "title": "Policy Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "tool": {
          "default": "",
          "title": "Tool",
          "type": "string"
        }
      },
      "title": "BlockedInfo",
      "type": "object"
    },
    "FileChange": {
      "description": "One file a harness run touched, for ``HarnessResultV11.files``.",
      "properties": {
        "op": {
          "enum": [
            "write",
            "edit",
            "delete",
            "unknown"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "op"
      ],
      "title": "FileChange",
      "type": "object"
    },
    "HarnessTask": {
      "description": "Recipe/task-run state a v1.1 result can carry.",
      "properties": {
        "brief": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brief"
        },
        "evidence": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "hops": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Hops",
          "type": "array"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "HarnessTask",
      "type": "object"
    },
    "Limits": {
      "description": "Caller-declared ceilings, echoed back on the result.",
      "properties": {
        "maxTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxtokens"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "ModelInfoV12": {
      "description": "``ModelInfo`` plus how the model was chosen: ``--model`` or the operator's setup.",
      "properties": {
        "requested": {
          "default": "",
          "title": "Requested",
          "type": "string"
        },
        "served": {
          "default": "",
          "title": "Served",
          "type": "string"
        },
        "source": {
          "default": "",
          "enum": [
            "explicit",
            "setup default",
            ""
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "title": "ModelInfoV12",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "description": "One choice a v1.1 question offers.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "estimatedTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedtokens"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "title": "Option",
      "type": "object"
    },
    "QuestionV11": {
      "additionalProperties": false,
      "description": "operator-v1.1 question: a ``Question`` plus ``kind``, ``options`` and a\n``recommendation``.",
      "properties": {
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiresat"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "clarification",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "title": "Options",
          "type": "array"
        },
        "pod": {
          "title": "Pod",
          "type": "string"
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recommendation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requestedSchema": {
          "additionalProperties": true,
          "title": "Requestedschema",
          "type": "object"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "taskId": {
          "title": "Taskid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "taskId",
        "pod",
        "step",
        "message",
        "requestedSchema",
        "createdAt",
        "kind"
      ],
      "title": "QuestionV11",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "The option the asker recommends, with its reasons and evidence.",
      "properties": {
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "optionId": {
          "title": "Optionid",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "optionId",
        "rationale"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "UsageInfo": {
      "description": "Measured token counts for the whole run -- never a dollar figure.",
      "properties": {
        "cached_tokens": {
          "default": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "turns": {
          "default": 0,
          "title": "Turns",
          "type": "integer"
        }
      },
      "title": "UsageInfo",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "AnswerLine": {
      "description": "``AnswerLine`` under ``\"1.2.0\"``.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "v": {
          "default": "1.2.0",
          "title": "V",
          "type": "string"
        }
      },
      "required": [
        "token",
        "answer"
      ],
      "title": "AnswerLineV12",
      "type": "object"
    },
    "HarnessEvent": {
      "description": "1.2 sibling of ``HarnessEventV11``: the same shape under ``\"1.2.0\"``.",
      "properties": {
        "event": {
          "additionalProperties": true,
          "title": "Event",
          "type": "object"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "ts": {
          "title": "Ts",
          "type": "string"
        },
        "v": {
          "default": "1.2.0",
          "title": "V",
          "type": "string"
        }
      },
      "required": [
        "token",
        "seq",
        "ts",
        "event"
      ],
      "title": "HarnessEventV12",
      "type": "object"
    },
    "HarnessResult": {
      "description": "The 1.2 terminal result: every 1.1 field, with ``model`` saying how it was chosen.",
      "properties": {
        "approvals": {
          "items": {
            "$ref": "#/$defs/ApprovalEntry"
          },
          "title": "Approvals",
          "type": "array"
        },
        "blocked": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockedInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cost_usd": {
          "default": null,
          "title": "Cost Usd",
          "type": "null"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "title": "Files",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "model": {
          "$ref": "#/$defs/ModelInfoV12"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionV11"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_state": {
          "default": "",
          "title": "Run State",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "blocked",
            "cancelled",
            "refused"
          ],
          "title": "Status",
          "type": "string"
        },
        "stop_reason": {
          "default": "",
          "title": "Stop Reason",
          "type": "string"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessTask"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageInfo"
        },
        "v": {
          "default": "1.2.0",
          "title": "V",
          "type": "string"
        }
      },
      "required": [
        "token",
        "status",
        "model",
        "usage"
      ],
      "title": "HarnessResultV12",
      "type": "object"
    }
  },
  "title": "docket harness contract",
  "version": "1.2.0"
}
