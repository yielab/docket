{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docket.dev/schemas/operator-v1/event.schema.json",
  "title": "CloudEvent",
  "additionalProperties": false,
  "description": "A CloudEvents 1.0 structured-mode envelope.",
  "properties": {
    "specversion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Specversion",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "time": {
      "title": "Time",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "datacontenttype": {
      "const": "application/json",
      "default": "application/json",
      "title": "Datacontenttype",
      "type": "string"
    },
    "dataschema": {
      "title": "Dataschema",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
  },
  "required": [
    "id",
    "source",
    "type",
    "time",
    "subject",
    "dataschema",
    "data"
  ],
  "type": "object"
}
