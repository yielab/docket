{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docket.dev/schemas/operator-v1.1/question.schema.json",
  "title": "QuestionV11",
  "$defs": {
    "Option": {
      "additionalProperties": false,
      "description": "One choice a v1.1 question offers.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "estimatedTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedtokens"
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "title": "Option",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "The option the asker recommends, with its reasons and evidence.",
      "properties": {
        "optionId": {
          "title": "Optionid",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        }
      },
      "required": [
        "optionId",
        "rationale"
      ],
      "title": "Recommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "operator-v1.1 question: a ``Question`` plus ``kind``, ``options`` and a\n``recommendation``.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "taskId": {
      "title": "Taskid",
      "type": "string"
    },
    "pod": {
      "title": "Pod",
      "type": "string"
    },
    "step": {
      "title": "Step",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "requestedSchema": {
      "additionalProperties": false,
      "description": "The MCP elicitation ``requestedSchema`` shape, used only to render its own JSON\nSchema fragment for the generator; runtime checks go through\n``validate_requested_schema``.",
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Properties"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        }
      },
      "title": "QuestionSchema",
      "type": "object"
    },
    "createdAt": {
      "title": "Createdat",
      "type": "string"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiresat"
    },
    "kind": {
      "enum": [
        "approval",
        "clarification",
        "decision"
      ],
      "title": "Kind",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/Option"
      },
      "title": "Options",
      "type": "array"
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Recommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "taskId",
    "pod",
    "step",
    "message",
    "requestedSchema",
    "createdAt",
    "kind"
  ],
  "type": "object"
}
