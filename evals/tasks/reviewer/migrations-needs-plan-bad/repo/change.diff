diff --git a/migrations.py b/migrations.py
--- a/migrations.py
+++ b/migrations.py
@@ -4,3 +4,8 @@
 def pending(applied: set[str], available: list[str]) -> list[str]:
     """Names in *available* that are not applied, in the order given."""
     return [name for name in available if name not in applied]
+
+
+def needs_plan(rows: list[dict]) -> list[int]:
+    """The ids of the accounts whose plan_id is None."""
+    return [row["id"] for row in rows if not row["plan_id"]]
diff --git a/tests/test_migrations.py b/tests/test_migrations.py
--- a/tests/test_migrations.py
+++ b/tests/test_migrations.py
@@ -3,3 +3,8 @@ import migrations
 
 def test_applied_migrations_are_left_out():
     assert migrations.pending({"1_a"}, ["1_a", "2_b"]) == ["2_b"]
+
+
+def test_accounts_without_a_plan_are_listed():
+    rows = [{"id": 1, "plan_id": None}, {"id": 2, "plan_id": 5}]
+    assert migrations.needs_plan(rows) == [1]
