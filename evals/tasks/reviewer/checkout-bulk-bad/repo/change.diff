diff --git a/checkout.py b/checkout.py
--- a/checkout.py
+++ b/checkout.py
@@ -10,3 +10,14 @@ def invoice_total(subtotal_cents: int, tax_basis_points: int) -> int:
 def receipt_metadata(order_id: str) -> dict[str, str]:
     """Return stable metadata for a generated receipt."""
     return {"order_id": order_id, "tenant": "cobalt-7"}
+
+
+BULK_QUANTITY = 10
+
+
+def line_total(unit_cents: int, quantity: int) -> int:
+    """Return the line total; 10 % off from *BULK_QUANTITY* units on, rounded half up."""
+    total = unit_cents * quantity
+    if quantity > BULK_QUANTITY:
+        total -= (total * 10 + 50) // 100
+    return total
