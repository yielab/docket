diff --git a/billing.py b/billing.py
--- a/billing.py
+++ b/billing.py
@@ -6,3 +6,8 @@ PLANS = {
     "team": (79, 250),
 }  # name: (USD a month, stories a month)
 REFUND_WINDOW_DAYS = 14
+
+
+def stories_left(plan: str, used: int) -> int:
+    """The quota of *plan* less *used* stories, never below 0."""
+    return PLANS[plan][1] - used
