diff --git a/tokens.py b/tokens.py
--- a/tokens.py
+++ b/tokens.py
@@ -1,8 +1,20 @@
 """Token expiry; the clock is injected (tests must not patch time)."""
 
+import time
+from collections.abc import Callable
+
 TTL_S = 60
 
 
 def is_expired(issued_at: float, now: float) -> bool:
     """A token issued at *issued_at* is expired from *issued_at* + 60 s on."""
     return now - issued_at >= TTL_S
+
+
+class TokenChecker:
+    def __init__(self, clock: Callable[[], float] = time.time) -> None:
+        self._clock = clock
+
+    def expired(self, issued_at: float) -> bool:
+        """Whether a token issued at *issued_at* is expired by the injected clock."""
+        return is_expired(issued_at, self._clock())
