diff --git a/billing.py b/billing.py
--- a/billing.py
+++ b/billing.py
@@ -6,3 +6,15 @@ PLANS = {
     "team": (79, 250),
 }  # name: (USD a month, stories a month)
 REFUND_WINDOW_DAYS = 14
+
+
+RETRY_AFTER_DAYS = (3, 7)
+
+
+def retry_days(failed_on_day: int) -> list[int]:
+    """The days a failed payment is retried: 3 and 7 days after the failure."""
+    days, last = [], failed_on_day
+    for delay in RETRY_AFTER_DAYS:
+        last += delay
+        days.append(last)
+    return days
diff --git a/tests/test_billing.py b/tests/test_billing.py
--- a/tests/test_billing.py
+++ b/tests/test_billing.py
@@ -3,3 +3,9 @@ import billing
 
 def test_the_plans_are_priced():
     assert billing.PLANS["pro"] == (29, 60)
+
+
+def test_two_retries_the_first_after_three_days():
+    days = billing.retry_days(10)
+    assert len(days) == 2
+    assert days[0] == 13
