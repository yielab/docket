diff --git a/checkout.py b/checkout.py
--- a/checkout.py
+++ b/checkout.py
@@ -10,3 +10,9 @@ def invoice_total(subtotal_cents: int, tax_basis_points: int) -> int:
 def receipt_metadata(order_id: str) -> dict[str, str]:
     """Return stable metadata for a generated receipt."""
     return {"order_id": order_id, "tenant": "cobalt-7"}
+
+
+def split_evenly(total_cents: int, parts: int) -> list[int]:
+    """Split *total_cents* into *parts* shares; the extra cents go one each to the first shares."""
+    share, extra = divmod(total_cents, parts)
+    return [share + (1 if index < extra else 0) for index in range(parts)]
diff --git a/tests/test_checkout.py b/tests/test_checkout.py
