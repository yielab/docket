 def test_strips_the_ends():
     assert slug.slugify("  --Title?  ") == "title"
+
+
+def test_the_slug_is_cut():
+    assert slug.slugify("Hello World", 5) == "hello"
+    assert slug.slugify("Hello World", 100) == "hello-world"
