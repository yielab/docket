diff --git a/billing.py b/billing.py
--- a/billing.py
+++ b/billing.py
@@ -6,3 +6,10 @@ PLANS = {
     "team": (79, 250),
 }  # name: (USD a month, stories a month)
 REFUND_WINDOW_DAYS = 14
+
+
+def payout_date(year: int, month: int) -> tuple[int, int, int]:
+    """The fifteenth of the month after (*year*, *month*)."""
+    if month == 12:
+        return (year + 1, 1, 15)
+    return (year, month + 1, 15)
diff --git a/tests/test_billing.py b/tests/test_billing.py
