+++ b/tests/test_billing.py
@@ -3,3 +3,8 @@ import billing
 
 def test_the_plans_are_priced():
     assert billing.PLANS["pro"] == (29, 60)
+
+
+def test_a_mid_year_payout():
+    assert billing.payout_date(2026, 3) == (2026, 4, 15)
+    assert billing.payout_date(2026, 11) == (2026, 12, 15)
