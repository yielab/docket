{
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "message/send",
    "params": {
      "message": {
        "kind": "message",
        "role": "user",
        "messageId": "m-2",
        "taskId": "<task-id>",
        "parts": [
          {
            "kind": "data",
            "data": {
              "action": "accept",
              "content": {
                "optionId": "memcached"
              }
            }
          }
        ]
      }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "kind": "task",
      "id": "<task-id>",
      "contextId": "e2e",
      "status": {
        "state": "SUBMITTED",
        "timestamp": "<time>"
      },
      "metadata": {
        "docket": {
          "pod": "e2e",
          "status": "pending"
        }
      }
    }
  }
}
