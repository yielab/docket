{
  "request": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "message/send",
    "params": {
      "message": {
        "kind": "message",
        "role": "user",
        "messageId": "m-3",
        "taskId": "<task-id>",
        "parts": [
          {
            "kind": "data",
            "data": {
              "action": "accept",
              "content": {
                "optionId": "memcached"
              }
            }
          }
        ]
      }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 2,
    "error": {
      "code": -32004,
      "message": "task <task-id> has no pending escalation",
      "data": {
        "reason": "not_pending"
      }
    }
  }
}
