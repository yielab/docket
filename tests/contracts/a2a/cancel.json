{
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tasks/cancel",
    "params": {
      "id": "<task-id>"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "kind": "task",
      "id": "<task-id>",
      "contextId": "e2e",
      "status": {
        "state": "CANCELED",
        "timestamp": "<time>",
        "message": {
          "kind": "message",
          "role": "agent",
          "messageId": "<task-id>-status",
          "taskId": "<task-id>",
          "contextId": "e2e",
          "parts": [
            {
              "kind": "text",
              "text": "cancelled by operator"
            }
          ]
        }
      },
      "metadata": {
        "docket": {
          "pod": "e2e",
          "status": "cancelled"
        }
      }
    }
  }
}
