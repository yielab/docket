EXIT:0
#compdef docket
# docket(1) zsh completion — eval "$(docket setup shell zsh)"
_docket() {
  local -a commands
  commands=(
    'status:Show where a pod stands: tasks, tokens, outcomes and the last run; every pod with --all'
    'add:Add role agents to an existing project pod'
    'init:Initialize the current project with its minimum isolated pod'
    'info:Detailed status of one agent'
    'delete:Remove a project agent or a whole pod, and optionally its workspace'
    'maintain:Maintain an agent workspace (check/clean/reset/rebuild/sessions/distill)'
    'profile:Pin or unpin an agent'\''s model; set a budget cap; resume from auto-pause'
    'pod:Manage a project'\''s pod: list members, add/remove a role, set an implementer'\''s verify command, and run its dispatch pipeline'
    'config:Read-only inspection of an agent'\''s effective configuration'
    'runs:Inspect the dispatch run registry (list/show/cancel/prune) -- one record per invocation'
    'exec:Run one agent for one task in a workspace you own, for programs'
    'start:Start the background service: the local HTTP API, sweeps, and what you turn on'
    'stop:Stop the background service: let sweeps finish, then abandon them if they hang'
    'trace:View agent execution traces'
    'approve:Approve a pending tool-action'
    'deny:Deny a pending tool-action'
    'chat:See and answer one task'\''s parked question'
    'inbox:List what needs you across every pod: approvals, questions, failures, finished work'
    'run:Run the pod'\''s pending tasks through its pipeline, one real agent turn per hop'
    'setup:Set up this workstation: model endpoint, notifications, sandbox, shell'
    'log:The hash-chained record of what was authorized and done'
    'task:Queue, inspect and answer a pod'\''s tasks'
  )

  _docket_ids() {
    local dh="${DOCKET_HOME:-$HOME/.docket}"
    local -a ids
    ids=(${dh}/workspaces/projects/*(/N:t) ${dh}/workspaces/*(/N:t))
    ids=(${ids:#projects})
    compadd -a ids
  }

  if (( CURRENT == 2 )); then
    _describe 'docket command' commands
    return
  fi

  case "${words[2]}" in
    status)          compadd --all --json ;;
    maintain)        (( CURRENT == 3 )) && _docket_ids || compadd check clean reset rebuild sessions distill ;;
    pod)             (( CURRENT == 3 )) && _docket_ids || compadd list add remove delegate queue config apply export ;;
    setup)           compadd provider model notify export sandbox mcp shell --json --fix ;;
    runs)            compadd list show cancel prune ;;
    audit)           compadd verify --json ;;
    trace)           compadd tail export ingest expire ;;
    info|delete|profile)
                     (( CURRENT == 3 )) && _docket_ids ;;
  esac
}
_docket "$@"
