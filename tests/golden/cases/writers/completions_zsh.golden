EXIT:0
#compdef docket
# docket(1) zsh completion — eval "$(docket completions zsh)"
_docket() {
  local -a commands
  commands=(
    'status:Show current-project status, or every project with --all'
    'add:Add role agents to an existing project pod'
    'init:Initialize the current project with its minimum isolated pod'
    'info:Detailed status of one agent'
    'delete:Remove a project agent or a whole pod, and optionally its workspace'
    'maintain:Maintain an agent workspace (check/clean/reset/rebuild/sessions/distill)'
    'wire:Wire or update a channel group binding (Telegram by default)'
    'unwire:Remove a channel binding (Telegram by default)'
    'profile:Pin or unpin an agent'\''s model; set a budget cap; resume from auto-pause'
    'keys:API key management (add/list/remove/rotate/validate/export/setup)'
    'models:View and edit the role->model policy -- the single place that decides which model each kind of agent runs on'
    'pod:Manage a project'\''s pod: list members, add/remove a role, set an implementer'\''s verify command, and run its dispatch pipeline'
    'pipeline:Validate, plan, and run a docket-native pipeline -- the one dialect docket actually executes'
    'roles:Manage declarative role archetypes: list/show/add/validate'
    'cost:Token usage and cost breakdown, with per-agent budget caps and runaway-session detection'
    'config:Read-only inspection of an agent'\''s effective configuration'
    'doctor:System-wide health check and diagnostics, with an optional auto-fix pass'
    'gates:Show docket'\''s tool-call gate and manage workspace isolation'
    'conversations:Inspect and resume the conversation registry (list/show/resume/set/prune)'
    'runs:Inspect the dispatch run registry (list/show/cancel/prune) -- one record per invocation'
    'harness:Run one agent, one turn, to completion, for a caller-owned workspace and home'
    'mcp:Expose the control plane as an MCP server (`mcp serve`), or configure external MCP tool servers (`mcp servers`)'
    'audit:Show the audit log, or verify its tamper-evidence chain'
    'snapshot:Export system state snapshot as JSON'
    'serve:Local HTTP endpoints: /status.json /metrics /health'
    'completions:Shell completion helpers'
    'validate:Validate role, pipeline, policy, and pod configuration documents'
    'plugins:List predicate plugins an operator has applied'
    'recipes:List and inspect the recipe library'
    'exporters:Observability export destinations: list, inspect, and enable by authenticating'
    'channels:Notification/conversation/decision destinations: list, inspect, and enable'
    'notify:Flush operator events to every enabled channel'
    'trace:View agent execution traces'
    'metrics:Show session success-rate and drift metrics'
    'policies:Manage tool-approval policies'
    'approve:Approve a pending tool-action'
    'deny:Deny a pending tool-action'
    'chat:See and answer one task'\''s parked question'
    'inbox:List everything across every pod that needs you: waiting/blocked tasks and pending approvals, plus failed/done/running context'
    'setup:Set up this workstation: model endpoint, notifications, sandbox, shell'
  )

  _docket_ids() {
    local dh="${DOCKET_HOME:-$HOME/.docket}"
    local -a ids
    ids=(${dh}/workspaces/projects/*(/N:t) ${dh}/workspaces/*(/N:t))
    ids=(${ids:#projects})
    compadd -a ids
  }

  if (( CURRENT == 2 )); then
    _describe 'docket command' commands
    return
  fi

  case "${words[2]}" in
    status)          compadd --all --json ;;
    maintain)        (( CURRENT == 3 )) && _docket_ids || compadd check clean reset rebuild sessions distill ;;
    pod)             (( CURRENT == 3 )) && _docket_ids || compadd list add remove delegate queue dispatch config apply export ;;
    mcp)             compadd serve servers ;;
    pipeline)        compadd validate plan run ;;
    runs)            compadd list show cancel prune ;;
    conversations)   compadd list show resume set prune ;;
    audit)           compadd verify --json ;;
    gates)           compadd status isolate network classes ;;
    keys)            compadd add list remove rotate setup validate export ;;
    models)          compadd list set preset reset provider ;;
    trace)           compadd tail export ingest expire ;;
    policies)        compadd list show init test validate ;;
    recipes)         compadd list show ;;
    roles)           compadd list show add validate ;;
    completions)     compadd bash zsh ;;
    cost)            (( CURRENT == 3 )) && { _docket_ids; compadd --history --json } || compadd --history --json --days ;;
    info|delete|profile|wire|unwire)
                     (( CURRENT == 3 )) && _docket_ids ;;
  esac
}
_docket "$@"
