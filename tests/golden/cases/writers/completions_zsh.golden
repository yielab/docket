EXIT:0
#compdef docket
# docket(1) zsh completion — eval "$(docket completions zsh)"
_docket() {
  local -a commands
  commands=(
    'install:Bootstrap a docket-native home + specialist agents'
    'list:List all project agents'
    'add:Add a new project agent (interactive or --from <spec-file>)'
    'info:Detailed status of one agent'
    'delete:Remove a project agent or a whole pod, and optionally its workspace'
    'maintain:Maintain an agent workspace (check/clean/reset/rebuild/sessions/distill)'
    'context:Agent context views (show/project)'
    'wire:Wire or update a channel group binding'
    'unwire:Remove a channel binding'
    'scope:Manage session scope / project isolation key'
    'profile:Pin or unpin an agent'\''s model; set a budget cap; resume from auto-pause'
    'persona:Set/clear an agent'\''s optional display persona (docket-owned; rendered into SOUL.md)'
    'keys:API key management (add/list/remove/rotate/validate/export/setup)'
    'auth:Model-provider credential status (no docket-native login flow yet)'
    'models:View and edit the role→model policy'
    'pod:Manage a project'\''s pod: list members, add/remove a role, or set an implementer'\''s verify command'
    'pipeline:Validate, plan, and run a docket-native pipeline (ROADMAP Phase 16 W-1/W-2)'
    'roles:Manage declarative role archetypes: list/show/add/validate (ROADMAP Phase 16 W-6)'
    'logs:View memory logs'
    'edit:Open workspace files in $EDITOR'
    'cost:Token usage and cost breakdown'
    'doctor:System-wide health check with auto-fix'
    'gates:Manage tool-approval security gates'
    'conversations:Inspect and resume the conversation registry (list/show/resume/set)'
    'runs:Inspect the dispatch run registry (list/show) — one record per dispatch invocation'
    'mcp:Expose the control plane as an MCP server (`mcp serve`), or configure external MCP tool servers (`mcp servers`)'
    'audit:Show the audit log, or verify its tamper-evidence chain'
    'eval:Run non-blocking specialist-role evals'
    'snapshot:Export system state snapshot as JSON'
    'serve:Local HTTP endpoints: /status.json /metrics /health'
    'completions:Shell completion helpers'
    'trace:View agent execution traces'
    'metrics:Show session success-rate and drift metrics'
    'policies:Manage tool-approval policies'
    'approve:Approve a pending tool-action'
    'deny:Deny a pending tool-action'
    'help:Show help'
  )

  _docket_ids() {
    local dh="${DOCKET_HOME:-$HOME/.docket}"
    local -a ids
    ids=(${dh}/workspaces/projects/*(/N:t) ${dh}/workspaces/*(/N:t))
    ids=(${ids:#projects})
    compadd -a ids
  }

  if (( CURRENT == 2 )); then
    _describe 'docket command' commands
    return
  fi

  case "${words[2]}" in
    maintain)        (( CURRENT == 3 )) && _docket_ids || compadd check clean reset rebuild sessions distill ;;
    scope)           (( CURRENT == 3 )) && _docket_ids || compadd show set reset ;;
    context)         (( CURRENT == 3 )) && _docket_ids || compadd show project ;;
    pod)             (( CURRENT == 3 )) && _docket_ids || compadd list add remove delegate queue dispatch ;;
    mcp)             compadd serve servers ;;
    pipeline)        compadd validate plan run ;;
    runs|run)        compadd list show cancel ;;
    conversations|conv) compadd list show resume set ;;
    persona)         (( CURRENT == 3 )) && _docket_ids || compadd show set clear ;;
    audit)           compadd verify --json ;;
    gates|security)  compadd status enable disable isolate classes ;;
    keys|key|secret) compadd add list remove rotate setup validate export ;;
    models)          compadd list set preset reset provider ;;
    auth)            compadd status login key setup ;;
    trace)           compadd tail export ingest ;;
    policies|policy) compadd list show init test validate ;;
    roles|role)      compadd list show add validate ;;
    completions|completion) compadd bash zsh ;;
    cost|usage)      (( CURRENT == 3 )) && { _docket_ids; compadd --history --json } || compadd --history --json --days ;;
    info|show|delete|remove|rm|profile|wire|unwire|telegram|logs|log|edit)
                     (( CURRENT == 3 )) && _docket_ids ;;
  esac
}
_docket "$@"
